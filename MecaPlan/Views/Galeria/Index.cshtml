@{
    ViewData["Title"] = "Galería";
    ViewData["Wide"] = true;
}

<section class="app-card app-card-form">
    <h1>Visor / Galería</h1>
    <p class="app-lead">Modelos 3D, renders y fotos de referencia de los diagnósticos y el armado.</p>

    <div class="app-gallery-grid">
        <article class="app-gallery-tile">
            <strong>Modelos 3D</strong>
            <span>Piezas, ensambles y vistas explosivas.</span>
        </article>
        <article class="app-gallery-tile">
            <strong>Renders</strong>
            <span>Visualizaciones del prototipo terminado.</span>
        </article>
        <article class="app-gallery-tile">
            <strong>Fotos de diagnóstico</strong>
            <span>Evidencia visual de fallas, conexiones y mediciones.</span>
        </article>
        <article class="app-gallery-tile">
            <strong>Referencias</strong>
            <span>Imágenes de apoyo para seguir los pasos de ensamblaje.</span>
        </article>
    </div>
</section>
