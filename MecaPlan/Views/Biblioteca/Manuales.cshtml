@model MecaPlan.Models.ViewModels.ManualesListViewModel
@{
    ViewData["Title"] = "Biblioteca > Manuales de Proyecto";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav class="bib-breadcrumb" aria-label="breadcrumb">
        <a asp-action="Index">Biblioteca</a>
        <span class="bib-breadcrumb-sep">/</span>
        <span class="bib-breadcrumb-current">Manuales de Proyecto</span>
    </nav>

    <!-- Hero Header -->
    <div class="bib-hero">
        <div class="bib-hero-content">
            <span class="bib-badge-pill">Documentación de Ensamble</span>
            <h1>Manuales de Proyecto</h1>
            <p>Guías técnicas completas con lista de materiales (BOM), diagramas esquemáticos paso a paso, código de control y protocolos de prueba para prototipos mecatrónicos.</p>
        </div>
    </div>

    <!-- Toolbar: Search & Filters -->
    <div class="bib-toolbar">
        <form method="get" asp-action="Manuales" class="bib-search-box">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input type="text" name="q" value="@Model.Query" class="bib-search-input" placeholder="Buscar por proyecto, descripción o microcontrolador..." />
        </form>

        <div class="bib-filter-pills">
            <a asp-action="Manuales" asp-route-estado="Todos" class="bib-pill @(string.IsNullOrEmpty(Model.FiltroEstado) || Model.FiltroEstado == "Todos" ? "active" : "")">Todos</a>
            <a asp-action="Manuales" asp-route-estado="Prototipado Activo" class="bib-pill @(Model.FiltroEstado == "Prototipado Activo" ? "active yellow" : "")">Prototipado Activo</a>
            <a asp-action="Manuales" asp-route-estado="En Desarrollo" class="bib-pill @(Model.FiltroEstado == "En Desarrollo" ? "active yellow" : "")">En Desarrollo</a>
            <a asp-action="Manuales" asp-route-estado="Completado" class="bib-pill @(Model.FiltroEstado == "Completado" ? "active" : "")">Completados</a>
            <a asp-action="Manuales" asp-route-estado="Archivado" class="bib-pill @(Model.FiltroEstado == "Archivado" ? "active" : "")">Archivados</a>
        </div>
    </div>

    <!-- Projects Grid -->
    <div class="bib-projects-grid">
        @foreach (var manual in Model.Manuales)
        {
            <div class="bib-project-card @(manual.EsProyectoUsuario ? "is-user" : "")" id="card-@manual.Id">
                <div class="bib-card-header-flex">
                    <span class="bib-status-badge @manual.EstadoCss">@manual.Estado</span>
                    <span class="bib-chip complexity">@manual.NivelComplejidad</span>
                </div>

                <h3 class="bib-project-title">@manual.Titulo</h3>
                <p class="bib-project-desc">@manual.Descripcion</p>

                <div class="bib-tags-row">
                    <span class="bib-chip micro">@manual.Microcontrolador</span>
                    <span class="bib-chip">@manual.ComponentesBOM.Count componentes</span>
                    @if (manual.EsProyectoUsuario)
                    {
                        <span class="bib-chip micro">Proyecto Propio</span>
                    }
                </div>

                <button type="button" class="bib-btn-open-manual" onclick="abrirModalManual('@manual.Id')">
                    <span>Ver Manual Completo</span>
                    <span>→</span>
                </button>
            </div>
        }
    </div>
</div>

<!-- Modal Interactivo Multidimensional de Manual -->
<div id="bibManualModalBackdrop" class="bib-modal-backdrop" onclick="cerrarModalManual(event)">
    <div class="bib-modal-window" onclick="event.stopPropagation()">
        <!-- Header -->
        <div class="bib-modal-header">
            <div class="bib-modal-title-wrap">
                <h2 id="modalManualTitulo">Manual de Proyecto</h2>
                <div class="bib-modal-subtitle">
                    <span id="modalManualMicro">Microcontrolador</span>
                    <span>•</span>
                    <span id="modalManualEstado">Estado</span>
                </div>
            </div>
            <button type="button" class="bib-modal-close-btn" onclick="cerrarModalManualDirecto()" aria-label="Cerrar">✕</button>
        </div>

        <!-- Tabs Navigation -->
        <div class="bib-modal-tabs-nav">
            <button type="button" class="bib-tab-btn active" onclick="cambiarPestanaManual('tab-bom', this)">
                1. Lista de Materiales (BOM)
            </button>
            <button type="button" class="bib-tab-btn" onclick="cambiarPestanaManual('tab-ensamble', this)">
                2. Ensamble y Conexiones
            </button>
            <button type="button" class="bib-tab-btn" onclick="cambiarPestanaManual('tab-codigo', this)">
                3. Firmware y Notas
            </button>
            <button type="button" class="bib-tab-btn" onclick="cambiarPestanaManual('tab-pruebas', this)">
                4. Verificación QA
            </button>
        </div>

        <!-- Body Content -->
        <div class="bib-modal-body">
            <!-- TAB 1: BOM -->
            <div id="tab-bom" class="bib-tab-pane active">
                <div class="bib-bom-table-wrap">
                    <table class="bib-table">
                        <thead>
                            <tr>
                                <th>Componente</th>
                                <th>Cant.</th>
                                <th>Categoría</th>
                                <th>Especificación Técnica</th>
                                <th>Estado en Almacén</th>
                                <th>Ficha</th>
                            </tr>
                        </thead>
                        <tbody id="modalBomTbody">
                            <!-- Inyectado vía JavaScript -->
                        </tbody>
                    </table>
                </div>
                <div class="bib-tags-row" style="margin-top: 10px;">
                    <span id="modalBomTotalCost" class="bib-chip" style="font-weight: 700; color: var(--bib-yellow-primary);">Costo Estimado BOM: $0.00 MXN</span>
                </div>
            </div>

            <!-- TAB 2: Ensamble Visual -->
            <div id="tab-ensamble" class="bib-tab-pane">
                <div class="bib-stepper-wrap" id="modalPasosContainer">
                    <!-- Inyectado vía JavaScript -->
                </div>
            </div>

            <!-- TAB 3: Código de Firmware -->
            <div id="tab-codigo" class="bib-tab-pane">
                <div class="bib-code-card">
                    <div class="bib-code-head">
                        <span class="bib-code-lang">C++ / Arduino IDE</span>
                        <button type="button" class="bib-btn-copy" onclick="copiarCodigoManual()">Copiar Código</button>
                    </div>
                    <pre class="bib-code-pre"><code id="modalCodigoFirmware">// Firmware de control</code></pre>
                </div>
                <div class="bib-callout-advice" id="modalConsejoProfesor">
                    <!-- Inyectado vía JavaScript -->
                </div>
            </div>

            <!-- TAB 4: Checklist de Pruebas -->
            <div id="tab-pruebas" class="bib-tab-pane">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <span style="font-size: 0.85rem; font-weight: 700; color: var(--bib-text-main);">Progreso de Pruebas de Funcionamiento</span>
                    <span id="modalChecklistProgressText" style="font-size: 0.8rem; font-weight: 700; color: var(--bib-purple-light);">0%</span>
                </div>
                <div class="bib-progress-bar-wrap">
                    <div id="modalChecklistProgressFill" class="bib-progress-fill" style="width: 0%;"></div>
                </div>

                <div class="bib-checklist-wrap" id="modalChecklistContainer">
                    <!-- Inyectado vía JavaScript -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mock Data JSON Payload -->
<script>
    window.mecaManualesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Manuales));
</script>
