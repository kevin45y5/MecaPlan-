@model IReadOnlyList<Proyecto>
@{
    ViewData["Title"] = "Proyectos";
    ViewData["Wide"] = true;
}

<section class="app-card app-card-form">
    <div class="app-page-head">
        <div>
            <h1>Proyectos</h1>
            <p class="app-lead">Tus proyectos de mecatrónica, con componentes, código y pasos de ensamblaje.</p>
        </div>
        <a class="app-btn" asp-controller="Proyectos" asp-action="Crear">Crear proyecto</a>
    </div>

    @if (TempData["Aviso"] is string aviso)
    {
        <p class="app-notice">@aviso</p>
    }

    @if (Model.Count == 0)
    {
        <p class="app-empty">Aún no tienes proyectos. Crea el primero para generar la lista de materiales y el plan de armado.</p>
    }
    else
    {
        <ul class="app-list">
            @foreach (var proyecto in Model)
            {
                <li>
                    <a class="app-list-link" asp-controller="Proyectos" asp-action="Workspace" asp-route-id="@proyecto.ProyectoID">
                        <strong>@proyecto.NombreProyecto</strong>
                        <span>@proyecto.NivelComplejidad · @proyecto.Estado · @proyecto.FechaCreacion.ToString("dd/MM/yyyy")</span>
                    </a>
                </li>
            }
        </ul>
    }
</section>
