@{ ViewData["Title"] = "Tu semestre, bajo control"; }
<section class="hero"><div class="container hero-grid"><div>
    <p class="eyebrow">Organización académica</p><h1>Tu tiempo merece un <em>buen plan.</em></h1>
    <p class="hero-copy">MecaPlan reúne tus prioridades académicas en un espacio simple, claro y hecho para avanzar con intención.</p>
    <div class="button-row"><a class="button-primary" asp-controller="Account" asp-action="Register">Empezar ahora</a><a class="button-secondary" asp-controller="Account" asp-action="Login">Ya tengo una cuenta</a></div>
</div><aside class="hero-card" aria-label="Vista previa de tu progreso"><span class="card-label">TU SEMANA EN FOCO</span><div class="progress-head"><strong>72%</strong><span class="card-label">completado</span></div><div class="progress-track"><span class="progress-value"></span></div><ul class="task-list"><li><span class="task-check">✓</span>Repasar notas de mecánica</li><li><span class="task-check">✓</span>Entregar práctica de laboratorio</li><li><span class="task-check">✓</span>Planificar la próxima semana</li></ul></aside></div></section>
