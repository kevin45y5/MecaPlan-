@model MecaPlan.ViewModels.Account.RegisterViewModel
@{ ViewData["Title"] = "Crear cuenta"; }
<section class="auth-page"><div class="auth-shell register-shell">
    <a class="auth-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">M</span> MecaPlan</a>
    <h1 class="auth-title">Empieza con claridad.</h1><p class="auth-subtitle">Crea tu cuenta y toma el control de tu semestre.</p>
    <form asp-action="Register" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
        <div class="form-two-cols"><div class="form-group"><label class="form-label" asp-for="Nombre">Nombre</label><input class="form-control" asp-for="Nombre" autocomplete="given-name" placeholder="Tu nombre" /><span asp-validation-for="Nombre" class="field-validation-error"></span></div><div class="form-group"><label class="form-label" asp-for="Apellido">Apellido</label><input class="form-control" asp-for="Apellido" autocomplete="family-name" placeholder="Tu apellido" /><span asp-validation-for="Apellido" class="field-validation-error"></span></div></div>
        <div class="form-group"><label class="form-label" asp-for="Carnet">Carnet</label><input class="form-control" asp-for="Carnet" autocomplete="off" placeholder="Ej. AB12345" /><span asp-validation-for="Carnet" class="field-validation-error"></span></div>
        <div class="form-group"><label class="form-label" asp-for="Email">Correo electrónico</label><input class="form-control" asp-for="Email" autocomplete="email" placeholder="tu@correo.com" /><span asp-validation-for="Email" class="field-validation-error"></span></div>
        <div class="form-two-cols"><div class="form-group"><label class="form-label" asp-for="Password">Contraseña</label><input class="form-control" asp-for="Password" autocomplete="new-password" placeholder="Mínimo 8 caracteres" /><span asp-validation-for="Password" class="field-validation-error"></span></div><div class="form-group"><label class="form-label" asp-for="Confirmation">Confirmar contraseña</label><input class="form-control" asp-for="Confirmation" autocomplete="new-password" placeholder="Repite tu contraseña" /><span asp-validation-for="Confirmation" class="field-validation-error"></span></div></div>
        <button class="button-primary auth-submit" type="submit">Crear mi cuenta</button></form><p class="auth-footer">¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a></p>
</div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
