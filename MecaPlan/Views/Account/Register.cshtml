@model RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Registrarse";
}

<div class="auth-page">
    <div class="auth-haze"></div>
    <div class="auth-orb auth-orb-a"></div>
    <div class="auth-orb auth-orb-b"></div>

    <div class="auth-container">
        <!-- Info panel -->
        <div class="auth-info">
            <div class="auth-info-content">
                <div class="auth-info-logo">
                    <div class="auth-info-logo-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                        </svg>
                    </div>
                    <span class="auth-info-logo-text">MecaPlan</span>
                </div>

                <ul class="auth-features">
                    <li class="auth-feature">
                        <div class="auth-feature-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                            </svg>
                        </div>
                        <div class="auth-feature-text">
                            <h3>Planificación inteligente</h3>
                            <p>La IA analiza tu proyecto y te sugiere componentes, circuitos y metodologías.</p>
                        </div>
                    </li>
                    <li class="auth-feature">
                        <div class="auth-feature-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                            </svg>
                        </div>
                        <div class="auth-feature-text">
                            <h3>Aprende mientras creas</h3>
                            <p>Explicaciones claras de cada paso para que entiendas la teoría detrás de la práctica.</p>
                        </div>
                    </li>
                    <li class="auth-feature">
                        <div class="auth-feature-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                                <line x1="9" y1="9" x2="9.01" y2="9"/>
                                <line x1="15" y1="9" x2="15.01" y2="9"/>
                            </svg>
                        </div>
                        <div class="auth-feature-text">
                            <h3>100% gratis para estudiantes</h3>
                            <p>Accede a todas las herramientas sin costo. Tu aprendizaje es nuestra prioridad.</p>
                        </div>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Form panel -->
        <div class="auth-form-panel">
            <div class="auth-brand-header">
                <div class="auth-brand-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                    </svg>
                </div>
            </div>

            <h1>Crear cuenta</h1>
            <p class="auth-subtitle">Ingresa tus datos para comenzar</p>

            <form asp-action="Register" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="auth-errors"></div>

                <div class="form-group">
                    <label asp-for="Nombre"></label>
                    <input asp-for="Nombre" autocomplete="given-name" placeholder="Tu nombre" />
                    <span asp-validation-for="Nombre" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Apellido"></label>
                    <input asp-for="Apellido" autocomplete="family-name" placeholder="Tu apellido" />
                    <span asp-validation-for="Apellido" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" autocomplete="username" placeholder="correo@ejemplo.com" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password"></label>
                    <div class="password-wrap">
                        <input asp-for="Password" autocomplete="new-password" placeholder="••••••••" />
                        <button type="button" class="password-toggle" data-toggle-password="Password" aria-label="Mostrar contraseña">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" stroke="currentColor" stroke-width="1.8" />
                                <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>

                <button type="submit" class="auth-submit">Registrarse</button>
            </form>

            <p class="auth-footer">
                ¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
