@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Access denied";
}

<div class="auth-page auth-page-single">
    <div class="auth-haze"></div>
    <section class="auth-glass" style="text-align: center;">
        <h1>Access denied</h1>
        <p class="auth-subtitle">No tienes permiso para ver esta página.</p>
        <a class="auth-submit" asp-controller="Home" asp-action="Index" style="display: inline-grid; place-items: center; text-decoration: none;">Volver</a>
    </section>
</div>
