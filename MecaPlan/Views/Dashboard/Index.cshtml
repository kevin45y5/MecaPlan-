@{ ViewData["Title"] = "Mi espacio"; }
<section class="dashboard"><div class="container"><div class="dashboard-welcome"><div><p>Tu espacio personal</p><h1 class="page-title">Hola, @User.Identity?.Name.</h1></div><p class="dashboard-note">Tu cuenta está lista. Pronto podrás organizar aquí cada detalle de tu semestre.</p></div>
<div class="stats-grid"><article class="stat-card"><span>Estado de cuenta</span><strong>Activa</strong></article><article class="stat-card"><span>Sesión</span><strong>Segura</strong></article><article class="stat-card"><span>Próximo paso</span><strong>Planificar</strong></article></div>
<article class="dashboard-panel"><h2>Este es tu punto de partida.</h2><p>Registra una idea para ver el código educativo y descargarlo para tu placa.</p><a class="button-primary" asp-controller="Projects" asp-action="Create">Crear una idea y descargar código</a><a class="button-secondary" asp-controller="Home" asp-action="Index">Ver inicio</a></article>
</div></section>
