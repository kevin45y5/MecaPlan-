@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<section class="error-page"><div class="container"><article class="error-card"><p class="eyebrow">Algo no salió como esperábamos</p><h1>Ocurrió un error.</h1><p>Intenta nuevamente en unos momentos. Si el problema continúa, comparte el identificador de solicitud con el equipo de soporte.</p>@if (Model.ShowRequestId) { <p><strong>Identificador:</strong> <code>@Model.RequestId</code></p> }<a class="button-primary" asp-controller="Home" asp-action="Index">Ir al inicio</a></article></div></section>
