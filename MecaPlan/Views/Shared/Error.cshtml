@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">No fue posible completar la solicitud.</h1>
<p role="alert">Inténtelo nuevamente. Si el problema persiste, comunique el identificador de correlación al equipo de soporte.</p>
@if (Model.ShowRequestId)
{
    <p><strong>Identificador de correlación:</strong> <code>@Model.RequestId</code></p>
}
