@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<section class="error-page"><div class="container"><article class="error-card"><p class="eyebrow">Algo no salió como esperábamos</p><h1>No fue posible completar la solicitud.</h1><p role="alert">Inténtalo nuevamente. Si el problema continúa, comparte el identificador de correlación con el equipo de soporte.</p>@if (Model.ShowRequestId) { <p><strong>Identificador de correlación:</strong> <code>@Model.RequestId</code></p> }<a class="button-primary" asp-controller="Home" asp-action="Index">Ir al inicio</a></article></div></section>
