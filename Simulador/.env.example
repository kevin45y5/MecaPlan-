# ============================================================
# sugoi_project :: variables de entorno.
# Copia este archivo a `.env` y rellena los valores reales.
#   cp .env.example .env
# Los servicios docker-compose leen estas variables.
# ============================================================

# --- MySQL (simulacion_2D_db) ---
# Contraseña del usuario root (solo dentro del contenedor)
MYSQL_ROOT_PASSWORD=root_secreto_cambiar

# Contraseña del usuario 'sugoi' (la que usarás en DBeaver)
MYSQL_PASSWORD=sugoi_secreto_cambiar

# --- API (simulacion_2D_api) ---
# Llave de Google Gemini (se queda en el backend, nunca en el navegador)
GEMINI_API_KEY=AIza_sustituir_por_tu_llave

# Modelo de Gemini (opcional, por defecto gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Orígenes permitidos por CORS (por defecto todos; restringe en prod)
# CORS_ORIGIN=*

# --- Puertos (opcionales) ---
# API expuesta por el contenedor simulacion_2D_api
# API_PORT=3001
# Frontend servido por nginx
# WEB_PORT=8080
